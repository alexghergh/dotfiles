#!/bin/sh

if [ -z "$STOW_FOLDERS" ]; then
    STOW_FOLDERS="desktop,fonts,user_scripts,fish,git,vim,wezterm,agents,codex,claude,llms,thunderbird"
fi

if [ -z "$DOTFILES" ]; then
    DOTFILES=$HOME/projects/dotfiles
fi

# for each dotfiles folder, "stow" it
for stow_folder in $(echo "$STOW_FOLDERS" | sed "s/,/ /g"); do
    if [ "$stow_folder" = "llms" ] || [ "$stow_folder" = "thunderbird" ]; then
        # for these, create the directories and symlink individual files inside;
        # for llms, so btrfs can correctly keep track of the directory itself
        # (see SETUP.md for more instructions on correctly doing btrfs
        # subvolume); for thunderbird, so a missing profile directory isn't
        # linked into the repo, which would make Thunderbird write the whole
        # profile there
        stow --restow --verbose --no-folding --dir="$DOTFILES" --target="$HOME" "$stow_folder"
    else
        stow --restow --verbose --dir="$DOTFILES" --target="$HOME" "$stow_folder"
    fi
done
unset stow_folder

unset DOTFILES
unset STOW_FOLDERS
